diff --git a/ov_core/CMakeLists.txt b/ov_core/CMakeLists.txt
index ecc1cc8..6e2a124 100644
--- a/ov_core/CMakeLists.txt
+++ b/ov_core/CMakeLists.txt
@@ -37,9 +37,9 @@ if (PYTHONLIBS_FOUND AND NOT DISABLE_MATPLOTLIB)
     list(APPEND thirdparty_libraries ${PYTHON_LIBRARIES})
 endif ()
 
-# We need c++14 for ROS2, thus just require it for everybody
+# The containing SPR_Drone_27 workspace requires c++20 (ADR 0003).
 # NOTE: To future self, hope this isn't an issue...
-set(CMAKE_CXX_STANDARD 14)
+set(CMAKE_CXX_STANDARD 20)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
 set(CMAKE_CXX_EXTENSIONS OFF)
 
